{
  "version": 2,
  "builds": [
    {
      "src": "project/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/googled5d9608a15a99b85.html",
      "dest": "project/dist/googled5d9608a15a99b85.html"
    },
    {
      "src": "/api/(.*)",
      "dest": "api/index.ts"
    },
    {
      "src": "/orders",
      "dest": "api/index.ts"
    },
    {
      "src": "/admin(.*)",
      "dest": "project/dist/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "project/dist/index.html"
    }
  ]
}
